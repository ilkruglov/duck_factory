{
  "description": "Keeps the state of the work through a compaction, brings the active plan back after it, and names the plan when a session starts.",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/context_hooks.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/context_hooks.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
